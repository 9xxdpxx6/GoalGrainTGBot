generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Goal {
  GAIN
  LOSE
  MAINTAIN
}

enum Budget {
  CHEAP
  MID
  HIGH
}

enum ActionType {
  REGISTER
  GENERATE_DAY
  REGENERATE_MEAL
  REQUEST_RECIPE
  EDIT_PROFILE
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum ProductCategory {
  MEAT
  FISH
  SEAFOOD
  EGG
  DAIRY
  LEGUME
  GRAIN
  BREAD
  FAT
  NUT
  VEGETABLE
  FRUIT
  SNACK
  SWEET
  DRINK
}

model User {
  userId          BigInt   @id @map("user_id")
  registeredAt    DateTime @default(now()) @map("registered_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")
  weightKg        Float    @map("weight_kg")
  heightCm        Int      @map("height_cm")
  goal            Goal
  targetCalories  Int      @map("target_calories")
  budget          Budget
  allowJunkFood   Boolean  @default(false) @map("allow_junk_food")
  limitations     Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  logs            Log[]

  @@map("users")
}

model Log {
  logId       BigInt     @id @default(autoincrement()) @map("log_id")
  userId      BigInt?    @map("user_id")
  timestamp   DateTime   @default(now())
  actionType  ActionType @map("action_type")
  inputData   Json       @map("input_data")
  outputData  Json       @map("output_data")
  user        User?      @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([actionType, timestamp])
  @@map("logs")
}

model Product {
  id               Int             @id @default(autoincrement())
  name             String          @unique
  usdaFdcId        Int             @map("usda_fdc_id")
  usdaDescription  String          @map("usda_description")
  priceSource      String          @map("price_source")
  caloriesPer100g  Float           @map("calories_per_100g")
  proteinPer100g   Float           @map("protein_per_100g")
  fatPer100g       Float           @map("fat_per_100g")
  carbsPer100g     Float           @map("carbs_per_100g")
  category         ProductCategory
  priceCategory    Budget          @map("price_category")
  restrictionTags  Json            @default("[]") @map("restriction_tags")
  usageTags        Json            @default("[]") @map("usage_tags")
  defaultServingG  Int             @map("default_serving_g")
  minServingG      Int             @map("min_serving_g")
  maxServingG      Int             @map("max_serving_g")
  isJunkFood       Boolean         @default(false) @map("is_junk_food")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@index([category])
  @@index([priceCategory])
  @@index([isJunkFood])
  @@map("products")
}
