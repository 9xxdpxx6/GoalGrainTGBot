{
  "name": "goalgrain",
  "version": "1.0.0",
  "description": "Telegram bot MVP for deterministic daily meal plans from source products with USDA-backed macros.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "migrate:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script --output prisma/migrations/0001_init/migration.sql",
    "postinstall": "prisma generate",
    "check": "npm run prisma:validate && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.6.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "dotenv": "^17.2.3",
    "mariadb": "^3.5.2",
    "openai": "^6.33.0",
    "pg": "^8.16.3",
    "telegraf": "^4.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
